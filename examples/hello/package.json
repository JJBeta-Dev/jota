{
  "name": "hello-jota",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Todo app built with Jota: dogfoods the runtime, the Vite plugin and Jota Guard.",
  "scripts": {
    "dev": "vite",

{
  "name": "jota-js",
  "version": "1.2.0",
  "description": "Jota runtime: fine-grained signals and a compiled-JSX DOM runtime (work in progress)",
  "license": "MIT",
  "author": "JJBeta",
  "homepage": "https://github.com/JJBeta-Dev/jota#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JJBeta-Dev/jota.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "jota",
    "frontend",
    "typescript",
    "accessibility"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./resource": {
      "types": "./dist/resource.d.ts",
      "import": "./dist/resource.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./dist/store.js"
    },
    "./i18n": {
      "types": "./dist/i18n.d.ts",
      "import": "./dist/i18n.js"
    },
    "./form": {
      "types": "./dist/form.d.ts",
      "import": "./dist/form.js"
    },
    "./content": {
      "types": "./dist/content.d.ts",
      "import": "./dist/content.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "import": "./dist/devtools.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "happy-dom": "^20.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5",
    "axe-core": "^4.10.0"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "happy-dom": ">=15",
    "axe-core": ">=4"
  },
  "peerDependenciesMeta": {
    "happy-dom": {
      "optional": true
    },
    "axe-core": {
      "optional": true
    }
  }
}

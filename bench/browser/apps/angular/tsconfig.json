{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"]
  },
  "files": ["src/main.ts"],
  "include": ["src/**/*.ts", "../shared.ts"],
  "angularCompilerOptions": { "strictTemplates": true }
}

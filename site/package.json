{
  "name": "jota-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Jota documentation site, built with Jota (static pages, no JavaScript).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "guard": "jota-guard src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "jota-js": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "happy-dom": "^20.0.0",
    "jota-guard": "workspace:*",
    "path-browserify": "^1.0.1",
    "puppeteer-core": "^25.17.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.7",
    "vite-plugin-jota": "workspace:*",
    "vitest": "^5.1.0"
  }
}
